<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>OjoScan</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>es</string>
	</array>
	<!-- Solo HTTPS estándar: sin preguntas de exportación de cifrado en cada subida. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Lo lee MainViewController.kt. -->
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>OjoScan usa la cámara para fotografiar tu ojo y guiarte (abre más el ojo, no te muevas) para que la foto salga bien.</string>
	<key>NSMotionUsageDescription</key>
	<string>OjoScan detecta si el teléfono se está moviendo para avisarte que lo mantengas quieto.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
